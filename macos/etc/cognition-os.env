# /etc/cognition-os/cognition-os.env
# macOS defaults for Cognition OS.

COGUSER=gross
COGDIR=/Users/gross
COG_SRC=/Users/gross/src
COG_VENV=/Users/gross/venvs/cognition-os
PYTHON_BIN=/usr/bin/python3
GIT_BIN=/usr/bin/git

BLUES_HOST=blues.clonesvr.com
COGBOOT_GIT_USER=gross
COGBOOT_GIT_BRANCH=main
COGBOOT_SSH_KEY=/Users/gross/.ssh/id_ed25519
COGBOOT_KNOWN_HOSTS=/Users/gross/.ssh/known_hosts
COGBOOT_RETRY_COUNT=5
COGBOOT_RETRY_DELAY=5

LICD_HOST=127.0.0.1
LICD_PORT=8777
LICD_ALLOWLIST=peace,blues,jazz,optiplex310,m2-arm64,xps-arm64,m1-macmini,m3-macbook
LICD_TOKEN=change-me
LICD_REQUIRE_TOKEN=0

TORTOISED_HOST=127.0.0.1
TORTOISED_PORT=8767

CLONES_BRAIN_HOST=127.0.0.1
CLONES_BRAIN_PORT=8765

DREAM_SERVER_HOST=127.0.0.1
DREAM_SERVER_PORT=8181
DREAM_SERVER_HEALTH_PATH=/server_status
